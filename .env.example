# Flask environment: development, production, testing
FLASK_ENV=development

# Security (REQUIRED in production — app refuses to start without it)
SECRET_KEY=your-secret-key-here

# Database
SQLALCHEMY_DATABASE_URI=mysql+pymysql://user:password@localhost/healthcare_db
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_POOL_RECYCLE=3600

# Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Rate limits (optional — defaults shown)
RATELIMIT_LOGIN=5/minute
RATELIMIT_REGISTER=3/minute
RATELIMIT_HEARTBEAT=60/minute

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ML model path (relative or absolute)
MODEL_PATH=patient_model.pkl

# Data retention (days)
RETENTION_RAW_DAYS=7
RETENTION_HOURLY_DAYS=90
RETENTION_DAILY_DAYS=365

# Request size limit (bytes, default 16MB)
MAX_CONTENT_LENGTH=16777216
