# ─── Docker Environment ───────────────────────────────────
# Copy this to .env and fill in real values before running:
#   cp .env.docker .env && nano .env

# Flask
FLASK_ENV=production
SECRET_KEY=change-me-to-a-random-64-char-string

# MySQL (used by docker-compose to create the database)
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=healthcare_db
MYSQL_USER=healthcare
MYSQL_PASSWORD=change-me-app-password

# SQLALCHEMY_DATABASE_URI is set automatically by docker-compose
# from the MySQL variables above. Override only if needed:
# SQLALCHEMY_DATABASE_URI=mysql+pymysql://user:pass@mysql/healthcare_db

# Redis (docker-compose sets RATELIMIT_STORAGE_URI automatically)
# RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Mail
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Celery (background tasks — docker-compose sets these automatically)
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/healthcare.log

# Celery (docker-compose sets these automatically)
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# Metrics
METRICS_ENABLED=true
LOG_FILE=logs/healthcare.log

# Metrics
METRICS_ENABLED=true

# ML model
MODEL_PATH=/app/patient_model.pkl

# Retention (days)
RETENTION_RAW_DAYS=7
RETENTION_HOURLY_DAYS=90
RETENTION_DAILY_DAYS=365
